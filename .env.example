# ============================================================
# TrendTales AI — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file and rename it to ".env"  (no .example)
#   2. Fill in YOUR actual keys below
#   3. NEVER commit your real .env file to GitHub (it's in .gitignore)
# ============================================================


# ─────────────────────────────────────────────
# NEWS API KEY  (Person 1 — Data Collection)
# ─────────────────────────────────────────────
# How to get it:
#   1. Go to https://newsapi.org/
#   2. Click "Get API Key" (free account)
#   3. Verify your email
#   4. Find your key at https://newsapi.org/account
#   Free tier: 100 requests/day, articles truncated to ~200 chars
# ─────────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here


# ─────────────────────────────────────────────
# HUGGING FACE TOKEN  (Person 2, 3, 4 — Models)
# ─────────────────────────────────────────────
# How to get it:
#   1. Go to https://huggingface.co/
#   2. Sign up / Log in
#   3. Go to Settings -> Access Tokens
#   4. Click "New token" -> give it a name -> Role: Read
#   5. Copy the token that starts with "hf_..."
#   Needed for: downloading models, uploading fine-tuned models
# ─────────────────────────────────────────────
HUGGINGFACE_TOKEN=hf_your_token_here


# ─────────────────────────────────────────────
# (OPTIONAL) OPENAI API KEY
# ─────────────────────────────────────────────
# Only needed if we use GPT as a fallback for story generation.
# For now this is NOT required - we use our LoRA fine-tuned LLM.
# How to get it: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────
# OPENAI_API_KEY=sk-your_openai_key_here
